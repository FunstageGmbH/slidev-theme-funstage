{
  "name": "slidev-theme-funstage",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "description": "The Funstage 2025 Google Slides template as a Slidev theme",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=18.0.0",
    "slidev": ">=0.48.0"
  },
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build",
    "export": "slidev export",
    "screenshot": "slidev export --format png"
  },
  "dependencies": {
    "@fontsource/quicksand": "^5.3.0"
  },
  "devDependencies": {
    "@slidev/cli": "^53.1.0"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "canvasWidth": 1280,
      "aspectRatio": "16/9",
      "fonts": {
        "provider": "none",
        "sans": "Quicksand"
      }
    }
  }
}
